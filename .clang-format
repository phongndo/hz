BasedOnStyle: LLVM
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
AllowShortFunctionsOnASingleLine: Inline
BreakBeforeBraces: Attach
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"hz/'
    Priority: 1
  - Regex: '^<(CLI|catch2|nlohmann|toml\+\+|sqlite3)'
    Priority: 2
  - Regex: '^<'
    Priority: 3
