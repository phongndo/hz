{% set detected_os = detect_api.detect_os() %}
{% set compiler, compiler_version, _ = detect_api.detect_default_compiler() %}

[settings]
os={{ detected_os }}
arch={{ detect_api.detect_arch() }}
build_type=Debug
compiler={{ compiler }}
compiler.version={{ detect_api.default_compiler_version(compiler, compiler_version) }}
compiler.cppstd=23
compiler.libcxx={{ "libc++" if detected_os == "Macos" else "libstdc++11" }}

[conf]
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
tools.cmake.cmaketoolchain:generator=Ninja
