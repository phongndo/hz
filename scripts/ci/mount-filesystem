#!/usr/bin/env bash
# Creates a loopback filesystem of the requested type and mounts it for the
# test suite. Run as root: mount-filesystem <btrfs|xfs|ext4|zfs> <mountpoint> <owner> [size]
set -euo pipefail

filesystem=$1
mountpoint=$2
owner=$3
image_size=${4:-2G}
image="/var/tmp/hz-${filesystem}.img"

mkdir -p "$mountpoint"
truncate -s "$image_size" "$image"

case "$filesystem" in
  btrfs)
    apt-get install -y -q btrfs-progs >/dev/null
    mkfs.btrfs -q "$image"
    mount -o compress=zstd:1 "$image" "$mountpoint"
    ;;
  xfs)
    apt-get install -y -q xfsprogs >/dev/null
    mkfs.xfs -q -m reflink=1 "$image"
    mount "$image" "$mountpoint"
    ;;
  ext4)
    mkfs.ext4 -q "$image"
    mount "$image" "$mountpoint"
    ;;
  zfs)
    apt-get install -y -q zfsutils-linux >/dev/null
    modprobe zfs
    zpool create -m "$mountpoint" hztest "$image"
    zfs set compression=zstd hztest
    ;;
  *)
    echo "unknown filesystem: $filesystem" >&2
    exit 2
    ;;
esac

chown "$owner" "$mountpoint"
findmnt -T "$mountpoint" -o TARGET,FSTYPE,OPTIONS
