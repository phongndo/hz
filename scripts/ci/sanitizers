#!/usr/bin/env bash
set -euo pipefail

scripts/ci/configure sanitizers -DHZ_BUILD_TESTS=ON -DHZ_BUILD_BENCHMARKS=OFF
cmake --build --preset sanitizers

leak_detection=1
if [[ "$(uname -s)" == Darwin ]]; then
  leak_detection=0
fi
export ASAN_OPTIONS="detect_leaks=${leak_detection}:strict_string_checks=1"
export UBSAN_OPTIONS="print_stacktrace=1:halt_on_error=1"
scripts/ci/test sanitizers
./build/sanitizers/hz --help >/dev/null
