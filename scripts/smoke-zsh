#!/usr/bin/env zsh
set -euo pipefail

repo_dir="${0:A:h:h}"
cd "$repo_dir"
cargo build -p hz-cli --locked

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT
mkdir -p "$tmp_dir/bin" "$tmp_dir/target"
cat > "$tmp_dir/bin/hz" <<'SH'
#!/usr/bin/env sh
set -eu
if [ "${1:-}" = "__complete" ]; then
  printf '%s\n' alpha beta
  exit 0
fi
printf '%s\n' "$@" > "$HZ_ARGS"
printf '%s\n' "$HZ_TARGET"
SH
chmod +x "$tmp_dir/bin/hz"

"$repo_dir/target/debug/hz" shell zsh > "$tmp_dir/hz.zsh"

HZ_ARGS="$tmp_dir/args" \
HZ_TARGET="$tmp_dir/target" \
HZ_COMPLETIONS="$tmp_dir/completions" \
PATH="$tmp_dir/bin:$PATH" \
HZ_INTEGRATION="$tmp_dir/hz.zsh" \
zsh -fc '
  setopt nomatch
  (( ! $+functions[compdef] ))
  source "$HZ_INTEGRATION"

  (( $+functions[compdef] ))
  [[ "${_comps[hz]:-}" == "_hz_complete" ]]
  [[ "${_comps[_hz]:-}" == "_hz_complete" ]]

  eval "hz new fix(broker)"
  [[ "$PWD" == "$HZ_TARGET" ]]
  [[ "$(cat "$HZ_ARGS")" == "$(printf "%s\n" new "fix(broker)" --path-only)" ]]

  eval "hz new -- -scratch"
  [[ "$PWD" == "$HZ_TARGET" ]]
  [[ "$(cat "$HZ_ARGS")" == "$(printf "%s\n" new --path-only -- -scratch)" ]]

  eval "hzcd fix(broker)"
  [[ "$PWD" == "$HZ_TARGET" ]]
  [[ "$(cat "$HZ_ARGS")" == "$(printf "%s\n" path "fix(broker)")" ]]

  eval "hz git handoff root"
  [[ "$PWD" == "$HZ_TARGET" ]]
  [[ "$(cat "$HZ_ARGS")" == "$(printf "%s\n" git handoff root --path-only)" ]]

  [[ "${aliases[hz]:-}" == "noglob _hz" ]]
  [[ "${aliases[hzcd]:-}" == "noglob _hzcd" ]]
  [[ "${aliases[hzroot]:-}" == "noglob _hzroot" ]]

  compadd() {
    while [[ "$#" -gt 0 ]]; do
      if [[ "$1" == "-a" ]]; then
        shift
        eval "print -rl -- \"\${${1}[@]}\"" >> "$HZ_COMPLETIONS"
      fi
      shift
    done
  }

  : > "$HZ_COMPLETIONS"
  _hz_targets
  grep -qx -- "alpha" "$HZ_COMPLETIONS"
  grep -qx -- "beta" "$HZ_COMPLETIONS"
'
